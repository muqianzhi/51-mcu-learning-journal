   3          void UartInit()         //4800bps@11.0592MHz
   4          {
   5   1              PCON |= 0x80;           //使能波特率倍速位SMOD
   6   1              SCON = 0x50;            //8位数据,可变波特率
   7   1              TMOD &= 0x0F;           //清除定时器1模式位
   8   1              TMOD |= 0x20;           //设定定时器1为8位自动重装方式
   9   1              TL1 = 0xF4;             //设定定时初值
  10   1              TH1 = 0xF4;             //设定定时器重装值
  11   1              ET1 = 0;                //禁止定时器1中断
  12   1              TR1 = 1;                //启动定时器1
  13   1              EA=1;
  14   1              ES=1;
  15   1      }
  16          
  17          void UART_SendByte(unsigned char Byte)
  18          {
  19   1              SBUF=Byte;
  20   1              while(TI==0);
  21   1              TI=0;
  22   1      }
